<%@ Master Language="C#"
    AutoEventWireup="true"
    CodeFile="Site.Master.cs"
    Inherits="CostWise.Site" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml" lang="he" dir="rtl">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title><%: Page.Title %> - CostWise</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.rtl.min.css"
        integrity="sha384-CfCrinSRH2IR6a4e6fy2q6ioOX7O6Mtm1L9vRvFZ1trBncWmMePhzvafv7oIcWiW" crossorigin="anonymous" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body class="bg-light">
    <form id="MainForm" runat="server" enctype="multipart/form-data">
        <header class="navbar navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <div class="d-flex align-items-center gap-3">
                    <asp:Image ID="TopBusinessLogoImage" runat="server" Width="42" Height="42" CssClass="rounded-circle object-fit-cover border" AlternateText="לוגו העסק" Visible="false" />

                    <asp:Panel ID="TopBusinessLogoFallbackPanel" runat="server" CssClass="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold"
                        Style="width: 42px; height: 42px;" role="img" aria-label="לוגו ברירת מחדל של CostWise">
                        CW
                    </asp:Panel>
                    <div>
                        <asp:Label ID="BusinessNameLabel" runat="server" CssClass="d-block text-white fw-semibold" />
                        <h1 class="h5 mb-0 text-white"><%: Page.Title %></h1>
                    </div>
                </div>
                <asp:Button ID="LogoutButton" runat="server" Text="יציאה" CssClass="btn btn-outline-light" CausesValidation="false" OnClick="LogoutButton_Click" />
            </div>
        </header>
        <div class="container-fluid">
            <div class="row" style="min-height: calc(100vh - 67px);">
                <aside class="col-12 col-md-3 col-lg-2 bg-white border-end p-3">
                    <nav aria-label="ניווט ראשי">
                        <ul class="nav nav-pills flex-column gap-1">
                            <li class="nav-item">
                                <a
                                    class='<%= GetNavigationLinkCssClass("~/Dashboard.aspx") %>'
                                    href='<%: ResolveUrl("~/Dashboard.aspx") %>'>לוח בקרה
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class='<%= GetNavigationLinkCssClass("~/MeasurementUnits.aspx") %>'
                                    href='<%: ResolveUrl("~/MeasurementUnits.aspx") %>'>יחידות מידה
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class='<%= GetNavigationLinkCssClass("~/Ingredients.aspx") %>'
                                    href='<%: ResolveUrl("~/Ingredients.aspx") %>'>רכיבים
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class='<%= GetNavigationLinkCssClass("~/Products.aspx") %>'
                                    href='<%: ResolveUrl("~/Products.aspx") %>'>מוצרים
                                </a>
                            </li>

                            <li class="nav-item">
                                <span
                                    class="nav-link disabled" aria-disabled="true">חישוב עלויות
                                </span>
                            </li>

                            <li class="nav-item">
                                <a
                                    class='<%= GetNavigationLinkCssClass("~/CalculationHistory.aspx") %>'
                                    href='<%: ResolveUrl("~/CalculationHistory.aspx") %>'>היסטוריית חישובים
                                </a>
                            </li>

                            <li class="nav-item">
                                <a
                                    class='<%= GetNavigationLinkCssClass("~/BusinessProfile.aspx") %>'
                                    href='<%: ResolveUrl("~/BusinessProfile.aspx") %>'>פרופיל העסק
                                </a>
                            </li>
                        </ul>
                    </nav>
                </aside>

                <main class="col-12 col-md-9 col-lg-10 py-4 px-4">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>
            </div>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
